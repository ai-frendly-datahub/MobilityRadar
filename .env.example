# MobilityRadar optional environment variables.
# Skip files record environment variable names only. Do not commit values.

# Notification webhook used by the crawler failure step.
# NOTIFICATION_WEBHOOK_URL=

# Optional notifier targets read by main.py. Names only.
# NOTIFICATION_EMAIL=
# NOTIFICATION_WEBHOOK=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# RSS timeout default is 45 seconds. TLS verification stays on.
# REQUEST_TIMEOUT=45

# MOBILITYRADAR_CONFIG_PATH=config/config.yaml
# MOBILITYRADAR_LOG_LEVEL=INFO
